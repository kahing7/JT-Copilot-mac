<Window x:Class="JT.Copilot.Desktop.Windows.GuidanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JT Copilot 表达引导"
        Width="430"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SourceInitialized="GuidanceWindow_OnSourceInitialized"
        DataContextChanged="GuidanceWindow_OnDataContextChanged"
        Closed="GuidanceWindow_OnClosed">
    <Border Background="#B8131C25"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Opacity="{Binding GuidanceOpacityScale}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              ShadowDepth="8"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="18,8,10,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Text="表达引导" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding SessionStatus}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CloseButton_OnClick"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭表达引导">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M6,6 L18,18 M18,6 L6,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="18,2,18,18"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="文档模板" />
                    <ComboBox Height="34"
                              Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding DocumentTemplateOptions}"
                              SelectedItem="{Binding SelectedDocumentTemplate, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="文档模板" />
                    <StackPanel Margin="2,7,0,0"
                                Orientation="Horizontal">
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="当前识别：" />
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="{Binding DetectedTemplateLabel}" />
                    </StackPanel>

                    <Rectangle Height="1"
                               Margin="0,16,0,14"
                               Fill="{StaticResource BorderBrush}" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="实时转录" />
                    <Border Padding="12,10"
                            Background="{StaticResource PanelRaisedBrush}"
                            CornerRadius="6">
                        <TextBlock MinHeight="44"
                                   MaxHeight="96"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding LiveTranscript}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="当前框架" />
                    <ItemsControl ItemsSource="{Binding FrameworkItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="4"
                                               Height="4"
                                               Margin="1,7,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Fill="{StaticResource AccentBrush}"
                                               RadiusX="2"
                                               RadiusY="2" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               LineHeight="18"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,5,0,0"
                            Padding="10,9"
                            Background="#1B2628"
                            BorderBrush="{StaticResource AccentStrongBrush}"
                            BorderThickness="2,0,0,0"
                            CornerRadius="5">
                        <StackPanel>
                            <TextBlock FontSize="10"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="下一句" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       LineHeight="20"
                                       Text="{Binding NextSentence}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="可展开方向" />
                    <ItemsControl ItemsSource="{Binding DirectionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,6"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MissingPointItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="可能遗漏" />
                        <ItemsControl ItemsSource="{Binding MissingPointItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,6"
                                               FontSize="12"
                                               Foreground="{StaticResource WarningBrush}"
                                               Text="{Binding}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="{Binding ReplacementMessage}" />
                        <Button Grid.Column="1"
                                Height="30"
                                Margin="10,-6,0,0"
                                MinWidth="70"
                                Style="{StaticResource CommandButtonStyle}"
                                Command="{Binding CopyOptimizedTextCommand}"
                                Content="复制结果" />
                    </Grid>
                    <TextBlock MaxHeight="150"
                               FontSize="12"
                               LineHeight="19"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding OptimizedTranscript}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
