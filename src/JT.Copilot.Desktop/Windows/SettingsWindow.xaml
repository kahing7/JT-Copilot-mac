<Window x:Class="JT.Copilot.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JT Copilot 设置"
        Width="440"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="SettingsWindow_OnSourceInitialized"
        Loaded="SettingsWindow_OnLoaded">
    <Border Background="{StaticResource PanelSolidBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Direction="270"
                              ShadowDepth="8"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="18,8,10,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Text="设置" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="JT Copilot" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Click="CloseButton_OnClick"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭设置">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M6,6 L18,18 M18,6 L6,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="18,4,18,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="麦克风" />
                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding AudioDevices}"
                              SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="麦克风设备" />

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="全局快捷键" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox"
                                 Height="36"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Cursor="Hand"
                                 Background="{StaticResource PanelRaisedBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Text="{Binding HotkeyText}"
                                 PreviewMouseLeftButtonDown="HotkeyBox_OnPreviewMouseLeftButtonDown"
                                 PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"
                                 PreviewKeyUp="HotkeyBox_OnPreviewKeyUp"
                                 LostKeyboardFocus="HotkeyBox_OnLostKeyboardFocus"
                                 AutomationProperties.Name="全局快捷键" />
                        <Button Grid.Column="1"
                                Height="36"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                Style="{StaticResource CommandButtonStyle}"
                                Click="ModifyHotkeyButton_OnClick"
                                Content="修改" />
                        <Button Grid.Column="2"
                                Height="36"
                                Margin="8,0,0,0"
                                MinWidth="0"
                                Style="{StaticResource CommandButtonStyle}"
                                Click="DefaultHotkeyButton_OnClick"
                                Content="默认" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Margin="2,6,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource DangerBrush}"
                                   Text="{Binding HotkeyError}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HotkeyError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HotkeyError}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="智谱 API" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ZhipuApiKeyBox"
                                     Height="36"
                                     Margin="0,0,8,0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource PanelRaisedBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     AutomationProperties.Name="智谱 API Key" />
                        <Button Grid.Column="1"
                                Height="36"
                                MinWidth="0"
                                Style="{StaticResource CommandButtonStyle}"
                                Click="SaveApiKeyButton_OnClick"
                                Content="保存 Key" />
                    </Grid>
                    <TextBlock x:Name="ApiKeyStatusText"
                               Margin="2,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="业务术语纠正" />
                    <TextBox MinHeight="92"
                             MaxHeight="150"
                             Padding="10,8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource PanelRaisedBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Text="{Binding CustomVocabulary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="业务术语纠正" />
                    <TextBlock Margin="2,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="每行格式：标准词=误识别1,误识别2" />

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="窗口置顶" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="保持悬浮窗位于其他窗口上方" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      Style="{StaticResource SwiftSwitchStyle}"
                                      IsChecked="{Binding IsTopmost, Mode=TwoWay}"
                                      AutomationProperties.Name="窗口置顶" />
                    </Grid>

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="悬浮球透明度" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="35"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding OrbOpacityPercent, Mode=TwoWay}"
                                Foreground="{StaticResource AccentBrush}"
                                AutomationProperties.Name="悬浮球透明度" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding OrbOpacityPercent, StringFormat={}{0:F0}%}" />
                    </Grid>

                    <TextBlock Margin="0,16,0,6"
                               Style="{StaticResource SectionLabelStyle}"
                               Text="引导面板透明度" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="40"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding GuidanceOpacityPercent, Mode=TwoWay}"
                                Foreground="{StaticResource AccentBrush}"
                                AutomationProperties.Name="引导面板透明度" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding GuidanceOpacityPercent, StringFormat={}{0:F0}%}" />
                    </Grid>

                    <Rectangle Height="1"
                               Margin="0,18,0,16"
                               Fill="{StaticResource BorderBrush}" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="录音文件" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="36"
                                 Margin="0,0,8,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True"
                                 Text="{Binding RecordingsDirectory, Mode=OneWay}"
                                 Background="{StaticResource PanelRaisedBrush}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource CommandButtonStyle}"
                                Command="{Binding OpenRecordingsFolderCommand}"
                                Content="打开" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="18,0,18,14">
                <Button Width="88"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource CommandButtonStyle}"
                        Click="CloseButton_OnClick"
                        Content="关闭" />
            </Grid>
        </Grid>
    </Border>
</Window>
