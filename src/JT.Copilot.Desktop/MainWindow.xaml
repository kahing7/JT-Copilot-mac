<Window x:Class="JT.Copilot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="JT Copilot"
        Width="72"
        Height="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="{Binding IsTopmost}"
        WindowStartupLocation="Manual"
        Opacity="0"
        Loaded="MainWindow_OnLoaded"
        Closing="MainWindow_OnClosing"
        SourceInitialized="MainWindow_OnSourceInitialized">
    <Grid Width="72"
          Height="72"
          Background="{x:Null}"
          Opacity="{Binding OrbOpacityScale}">
        <Border x:Name="OrbSurface"
                Width="64"
                Height="64"
                Background="#C2131C25"
                BorderThickness="1"
                CornerRadius="32"
                Cursor="Hand"
                MouseLeftButtonDown="Orb_OnMouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  ShadowDepth="5"
                                  Opacity="0.3"
                                  Color="#000000" />
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu Style="{StaticResource OrbContextMenuStyle}"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="设置"
                              Style="{StaticResource OrbMenuItemStyle}"
                              Command="{Binding OpenSettingsCommand}" />
                    <MenuItem Header="显示或隐藏引导面板"
                              Style="{StaticResource OrbMenuItemStyle}"
                              Command="{Binding ToggleGuidanceCommand}" />
                    <MenuItem Header="窗口置顶"
                              Style="{StaticResource OrbMenuItemStyle}"
                              Command="{Binding ToggleTopmostCommand}" />
                    <Separator Style="{StaticResource OrbMenuSeparatorStyle}" />
                    <MenuItem Header="退出"
                              Style="{StaticResource OrbMenuItemStyle}"
                              Command="{Binding ExitCommand}" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Ellipse x:Name="RecordingRing"
                         Width="58"
                         Height="58"
                         Fill="Transparent"
                         Stroke="#54FB7185"
                         StrokeThickness="2">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <Button Style="{StaticResource OrbMicButtonStyle}"
                        Tag="{Binding IsRecording}"
                        Command="{Binding ToggleRecordingCommand}"
                        ToolTip="{Binding MicrophoneActionLabel}"
                        AutomationProperties.Name="{Binding MicrophoneActionLabel}">
                    <Grid Width="24" Height="24">
                        <Viewbox Width="22" Height="22">
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <Path Data="M12,2 C10.3,2 9,3.3 9,5 L9,12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 L15,5 C15,3.3 13.7,2 12,2 Z M19,10 L19,12 C19,15.9 15.9,19 12,19 C8.1,19 5,15.9 5,12 L5,10 M12,19 L12,22"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Viewbox>
                        <Rectangle Width="10"
                                   Height="10"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>
                </Button>

                <Ellipse Width="7"
                         Height="7"
                         Margin="0,5,5,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         IsHitTestVisible="False">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#8A435362" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter Property="BorderBrush" Value="#B8FB7185" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#D7FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</Window>
